            <TextBlock Text="G" VerticalAlignment="Center"/>
            <TextBox x:Name="M2GreenBox" Width="40" Margin="5,0,10,0"/>

            <TextBlock Text="B" VerticalAlignment="Center"/>
            <TextBox x:Name="M2BlueBox" Width="40" Margin="5,0,0,0"/>
        </StackPanel>

        <TextBlock Text="M3 Name"/>
