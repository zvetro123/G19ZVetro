<Window x:Class="G19ZVetro.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="G19ZVetro"
        Height="300"
        Width="400">

    <StackPanel Margin="20">

        <TextBlock
            Text="G19ZVetro"
            FontSize="22"
            FontWeight="Bold"/>

        <TextBlock
            Margin="0,20,0,5"
            Text="Refresh Rate"/>

        <ComboBox
            x:Name="RefreshRateBox">

            <ComboBoxItem>250</ComboBoxItem>
            <ComboBoxItem>500</ComboBoxItem>
            <ComboBoxItem>1000</ComboBoxItem>

        </ComboBox>

        <CheckBox
            x:Name="StartupBox"
            Margin="0,15,0,15"
            Content="Start with Windows"/>

        <Button
            Content="Save"
            Click="Save_Click"/>

    </StackPanel>

</Window>
