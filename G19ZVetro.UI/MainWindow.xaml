                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="G1ValueBox"
                         Grid.Column="0"
                         Margin="0,0,5,0"/>

                    <Button Content="Browse"
                            Grid.Column="1"
                            Tag="G1ValueBox"
