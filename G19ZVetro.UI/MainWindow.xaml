<Window x:Class="G19ZVetro.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="G19ZVetro"
        Height="705"
        Width="400">

<ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
        <TextBlock
            Text="G19ZVetro"
            FontSize="22"
            FontWeight="Bold"/>

        <TextBlock
            Margin="0,20,0,5"
            Text="Refresh Rate"/>

        <ComboBox
            x:Name="RefreshRateBox">

            <ComboBoxItem>250</ComboBoxItem>
            <ComboBoxItem>500</ComboBoxItem>
            <ComboBoxItem>1000</ComboBoxItem>

        </ComboBox>

        <CheckBox
            x:Name="StartupBox"
            Margin="0,15,0,15"
            Content="Start with Windows"/>

        <TextBlock
            x:Name="KeyboardStatusText"
            Text="Keyboard Status: Unknown"
            Margin="0,10,0,0"/>

        <TextBlock
    Margin="0,20,0,10"
    FontWeight="Bold"
    FontSize="16"
    Text="Profiles"/>

        <TextBlock Text="M1 Name"/>
        <TextBox
            x:Name="M1NameBox"
            Margin="0,2,0,5"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="R" VerticalAlignment="Center"/>
            <TextBox x:Name="M1RedBox" Width="40" Margin="5,0,10,0"/>

            <TextBlock Text="G" VerticalAlignment="Center"/>
            <TextBox x:Name="M1GreenBox" Width="40" Margin="5,0,10,0"/>

            <TextBlock Text="B" VerticalAlignment="Center"/>
            <TextBox x:Name="M1BlueBox" Width="40" Margin="5,0,0,0"/>
        </StackPanel>

        <TextBlock Text="M2 Name"/>
