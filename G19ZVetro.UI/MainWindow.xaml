    FontSize="16"
    Text="Active Profile"/>

        <TextBlock
    x:Name="ActiveProfileText"
    Margin="0,0,0,10"
    Text="Current: M1 - Development"/>

        <StackPanel Orientation="Horizontal">

            <Button
        Content="Activate M1"
        Click="ActivateM1_Click"
        Margin="0,0,5,0"/>

            <Button
        Content="Activate M2"
        Click="ActivateM2_Click"
        Margin="0,0,5,0"/>

